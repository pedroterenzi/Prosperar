# ─────────────────────────────────────────────────────────────────────────────
#  Variáveis de ambiente — copie para .env.local (dev) e cadastre na Vercel (prod)
#  Supabase → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# 1) URL do projeto Supabase (público, vai para o bundle do browser)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# 2) Chave ANON (pública — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# 3) Chave SERVICE_ROLE (SECRETA — NUNCA prefixe com NEXT_PUBLIC_)
#    Usada apenas em rotas de servidor/scripts administrativos.
#    Na Vercel: marque como "Sensitive" e NÃO exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# 4) URL pública do app (usada nos redirects de Magic Link/OTP em produção)
#    Dev:  http://localhost:3000
#    Prod: https://app.suabarbearia.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
#  Dica de OTP por telefone (dev): Authentication → Providers → Phone → Test OTPs
#    +5511999990000 → código 123456
# ─────────────────────────────────────────────────────────────────────────────
